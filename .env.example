# Snowflake connection for api/query.ts
#
# Set these in the Vercel dashboard (Project -> Settings -> Environment
# Variables), NOT in a committed file. They are read server-side only.
# Do not prefix any of them with VITE_ — Vite inlines VITE_* into the
# browser bundle, which would publish the credential.
#
# Use a role with SELECT only on DB.SCH. The endpoint is reachable without
# signing in, so the role is the real blast radius.
#
# Names only. Never put a real value in this file — it is committed.
# In the Vercel dashboard, paste values WITHOUT surrounding quotes; the
# field takes the literal text, so quotes become part of the password.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=DB
SNOWFLAKE_SCHEMA=SCH
